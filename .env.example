# Скопируйте в .env (docker compose читает его автоматически).

# Postgres
POSTGRES_DB=tasks
POSTGRES_USER=tasks
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Адрес сайта для Caddy.
#   :80              — HTTP по IP сервера (без домена)
#   tasks.example.com — домен, HTTPS выдаётся автоматически
SITE_ADDRESS=:80

# Порты на хосте (менять не обязательно)
HTTP_PORT=80
HTTPS_PORT=443
# Postgres наружу только для локальной разработки
DB_PORT=127.0.0.1:5432

# Для локального запуска API без Docker (npm run dev:api).
# Порт 3001, потому что 3000 часто занят другими приложениями.
PORT=3001
DATABASE_URL=postgresql://tasks:change-me-to-a-long-random-string@127.0.0.1:5432/tasks
